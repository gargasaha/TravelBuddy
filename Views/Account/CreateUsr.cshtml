@model Usr
@{
    ViewData["Title"] = "Waybound Riders - Live the Journey";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #0f172a, #1e293b, #6366f1);
            min-height: 100vh;
            font-family: 'Poppins', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Card */
        .profile-card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(30px);
            border-radius: 30px;
            box-shadow: 0 30px 80px rgba(0,0,0,0.4);
            border: 1px solid rgba(255,255,255,0.1);
            width: 100%;
            max-width: 420px;
            padding-bottom: 10px;
            animation: fadeIn 0.6s ease-in-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px);}
            to { opacity: 1; transform: translateY(0);}
        }

        /* Header */
        .header-title {
            color: #fff;
            font-weight: 700;
            font-size: 26px;
            text-align: center;
            padding: 25px 0 10px;
        }

        /* Profile */
        .profile-section {
            text-align: center;
            padding: 10px 30px;
        }

        .profile-pic {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            border: 3px solid #818cf8;
            object-fit: cover;
            background: linear-gradient(45deg, #6366f1, #a855f7);
            transition: 0.4s;
            cursor: pointer;
        }

        .profile-pic:hover {
            transform: scale(1.08);
        }

        .profile-label {
            margin-top: 12px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            color: white;
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 13px;
            display: inline-block;
        }

        .welcome-text {
            margin-top: 10px;
            color: #e2e8f0;
            font-size: 15px;
        }

        /* Floating Input */
        .form-group {
            position: relative;
            margin-bottom: 22px;
        }

        .form-control {
            width: 100%;
            padding: 14px;
            border-radius: 14px;
            border: none;
            background: rgba(255,255,255,0.15);
            color: white;
            outline: none;
        }

        .form-control:focus {
            background: rgba(255,255,255,0.25);
            box-shadow: 0 0 0 2px #818cf8;
        }

        .form-group label {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #cbd5f5;
            font-size: 13px;
            pointer-events: none;
            transition: 0.3s;
        }

        .form-control:focus + label,
        .form-control:not(:placeholder-shown) + label {
            top: -8px;
            left: 10px;
            font-size: 11px;
            background: #1e293b;
            padding: 2px 6px;
            border-radius: 6px;
        }

        /* File input */
        .file-input {
            color: #cbd5f5;
        }

        /* Button */
        .btn-submit {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            border: none;
            border-radius: 14px;
            padding: 14px;
            font-weight: 600;
            color: white;
            width: 100%;
            transition: 0.3s;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(99,102,241,0.6);
        }

        /* Mobile */
        @@media (max-width: 500px) {
            .profile-card {
                margin: 10px;
                border-radius: 20px;
            }

            .profile-pic {
                width: 90px;
                height: 90px;
            }
        }
    </style>
</head>

<body>

<div class="profile-card">

    <div class="header-title">Live the Journey</div>

    <div class="profile-section">
        <img src="" id="profileImage" class="profile-pic">
        <div class="profile-label">Profile</div>
        <div class="welcome-text">Welcome Waybound Riders</div>
    </div>

    <form asp-action="CreateUsr" method="post" enctype="multipart/form-data" class="px-4">

        <div class="form-group">
            <input asp-for="name" class="form-control" placeholder=" " />
            <label>Name</label>
        </div>

        <div class="form-group">
            <input asp-for="email" type="email" class="form-control" placeholder=" " />
            <label>Email</label>
        </div>

        <div class="form-group">
            <input asp-for="password" type="password" class="form-control" placeholder=" " />
            <label>Password</label>
        </div>

        <div class="mb-4">
            <label class="form-label text-light">Profile Image</label>
            <input name="image" type="file" accept="image/*" class="form-control file-input" onchange="previewImage(event)" />
        </div>

        <button type="submit" class="btn btn-submit mb-3">Submit & Join</button>

    </form>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<partial name="_ValidationScriptsPartial" />

<script>
    function previewImage(event) {
        const file = event.target.files[0];
        const imagePreview = document.getElementById('profileImage');

        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                imagePreview.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    }
</script>

</body>
</html>