@{
    ViewData["Title"] = "Home Page";
    Layout=null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>TravelBuddy - Ride Together</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #0f0f0f;
            color: white;
            scroll-behavior: smooth;
        }

        .navbar {
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(10px);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 24px;
            color: #ff6a00 !important;
        }

        .hero {
            height: 100vh;
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.8)),
            url('https://images.unsplash.com/photo-1500534314209-a25ddb2bd429') center/cover;
            display: flex;
            align-items: center;
            text-align: center;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 700;
        }

        .highlight {
            color: #ff6a00;
        }

        .btn-main {
            background: linear-gradient(45deg, #ff6a00, #ff3c00);
            border: none;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            transition: 0.4s;
        }

        .btn-main:hover {
            transform: scale(1.05);
        }

        .section-title {
            font-weight: 700;
            margin-bottom: 50px;
        }

        .feature-box {
            background: #1a1a1a;
            padding: 30px;
            border-radius: 20px;
            transition: 0.4s;
        }

        .feature-box:hover {
            transform: translateY(-10px);
            background: #222;
        }

        .feature-icon {
            font-size: 40px;
            color: #ff6a00;
            margin-bottom: 15px;
        }

        .app-preview img {
            border-radius: 25px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.4);
        }

        .gallery img {
            border-radius: 20px;
            transition: 0.4s;
        }

        .gallery img:hover {
            transform: scale(1.07);
        }

        footer {
            background: #000;
            padding: 30px 0;
        }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark fixed-top">
    <div class="container">
        <a class="navbar-brand" href="#">🏍️ TravelBuddy</a>
        <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
                <li class="nav-item"><a class="nav-link" href="#screens">Screens</a></li>
                @* <li class="nav-item"><a class="nav-link" href="#download">Download</a></li> *@
                <li class="nav-item"><a class="nav-link" href="/Travel/CreateCommunity">Community</a></li>
                
            </ul>
        </div>
    </div>
</nav>

<!-- Hero -->
<section class="hero">
    <div class="container" data-aos="fade-up">
        <h1>Ride Smarter with <span class="highlight">TravelBuddy</span></h1>
        <p class="lead mt-3">Live Location Tracking • Group Chat • Voice Communication • SOS Alerts</p>
        <a href="#download" class="btn btn-main mt-4">Start Your Journey</a>
    </div>
</section>

<!-- Features -->
<section id="features" class="py-5">
    <div class="container text-center">
        <h2 class="section-title">Powerful Ride Features</h2>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up">
                <div class="feature-box">
                    <div class="feature-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <h5>Live Tracking</h5>
                    <p>Track every biker in real-time with interactive maps.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up">
                <div class="feature-box">
                    <div class="feature-icon"><i class="fa-solid fa-comments"></i></div>
                    <h5>Group Chat</h5>
                    <p>Instant messaging for smooth ride coordination.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up">
                <div class="feature-box">
                    <div class="feature-icon"><i class="fa-solid fa-microphone"></i></div>
                    <h5>Voice Talk</h5>
                    <p>Push-to-talk walkie-talkie style voice chat.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- App Preview -->
<section class="py-5 bg-dark">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6" data-aos="fade-right">
                <h2 class="fw-bold">Smart Ride Dashboard</h2>
                <p>Monitor speed, view group members, send SOS alerts and manage routes effortlessly.</p>
            </div>
            <div class="col-md-6 text-center app-preview" data-aos="fade-left">
                <img src="https://images.unsplash.com/photo-1516826957135-700dedea698c" class="img-fluid" alt="App Preview">
            </div>
        </div>
    </div>
</section>

<!-- Gallery -->
<section id="screens" class="py-5">
    <div class="container text-center">
        <h2 class="section-title">Adventure Moments</h2>
        <div class="row gallery g-4">
            <div class="col-md-4" data-aos="zoom-in">
                <img src="https://images.unsplash.com/photo-1502877338535-766e1452684a" class="img-fluid">
            </div>
            <div class="col-md-4" data-aos="zoom-in">
                <img src="https://images.unsplash.com/photo-1493238792000-8113da705763" class="img-fluid">
            </div>
            <div class="col-md-4" data-aos="zoom-in">
                <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee" class="img-fluid">
            </div>
        </div>
    </div>
</section>

<!-- Download -->
<section id="download" class="py-5 text-center bg-dark">
    <div class="container" data-aos="fade-up">
        <h2 class="fw-bold">Download TravelBuddy Now</h2>
        <p>Connect. Explore. Ride Together.</p>
        <button class="btn btn-main mt-3">Download App</button>
    </div>
</section>

<!-- Footer -->
<footer class="text-center">
    <div class="container">
        <p>© 2026 TravelBuddy | Built for Passionate Riders 🏍️</p>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
AOS.init({
    duration: 1000,
    once: true
});
</script>

</body>
</html>