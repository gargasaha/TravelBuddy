@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TravelBuddy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body {
                background-color: #f5f5f5;
            }
        
            .navbar {
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            }
        
            .profile-img {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                object-fit: cover;
            }
        
            .dropdown-toggle::after {
                content: none;
            }

            /* Create Community Button Styles */
            .fab-container {
                position: fixed;
                bottom: 30px;
                right: 30px;
                z-index: 1000;
            }

            .create-community-btn {
                width: 70px;
                height: 70px;
                font-size: 32px;
                border: none;
                border-radius: 50%;
                background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
                box-shadow: 0 4px 15px rgba(0, 123, 255, 0.35), 0 8px 25px rgba(0, 123, 255, 0.2);
                cursor: pointer;
                transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
                position: relative;
                overflow: hidden;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                color: white;
                font-weight: 600;
            }

            .create-community-btn:hover {
                transform: translateY(-8px) scale(1.08);
                box-shadow: 0 8px 25px rgba(0, 123, 255, 0.5), 0 12px 35px rgba(0, 123, 255, 0.3);
            }

            .create-community-btn:active {
                transform: translateY(-3px) scale(1.04);
            }

            .create-community-btn::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255, 255, 255, 0.25);
                border-radius: 50%;
                transform: translate(-50%, -50%);
                transition: width 0.7s ease-out, height 0.7s ease-out;
            }

            .create-community-btn:active::before {
                width: 200px;
                height: 200px;
            }
    </style>
</head>

<body>
    
    <!-- ...existing code... -->
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                
                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-outline-primary" type="button"
                            aria-expanded="false" aria-controls="collapseExample" id="communityBtn">
                        Communities
                    </button>
                </div>
                
                <div class="collapse" id="collapseExample">
                    <div class="card card-body" id="communitiesContainer" style="background-color: #f8f9fa;">
                        <div id="communitiesList">
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container py-0">
        <div class="row justify-content-center">
            <div class="col-md-8">
                
                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-outline-primary" type="button"
                            aria-expanded="false" aria-controls="collapseExample" id="rideBtn">
                        Rides
                    </button>
                </div>
                
                <div class="collapse" id="collapseExample">
                    <div class="card card-body" id="communitiesContainer" style="background-color: #f8f9fa;">
                        <div id="rideList">
                            hii
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="fab-container" style="display: flex; gap: 14px; align-items: center;">
        <a href="/Travel/CreateCommunity"
           style="text-decoration: none;"
           class="create-community-btn"
           title="Create a new community">
            👥
        </a>

        <a href="/Travel/CreateRide"
           style="text-decoration: none;"
           class="create-community-btn"
           title="Create a new ride">
            🏍️
        </a>
    </div>
    <!-- ...existing code... -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/js-cookie@3.0.1/dist/js.cookie.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var state = false;
var isLoaded = false;

function toBase64Image(imageData) {
    if (!imageData) return '';
    if (typeof imageData === 'string') return imageData;

    var bytes = imageData instanceof Uint8Array ? imageData : new Uint8Array(imageData);
    var binary = '';
    var chunkSize = 8192;

    for (var i = 0; i < bytes.length; i += chunkSize) {
        var end = Math.min(i + chunkSize, bytes.length);
        for (var j = i; j < end; j++) {
            binary += String.fromCharCode(bytes[j]);
        }
    }

    return btoa(binary);
}

$(document).ready(function () {
    var collapseElement = document.getElementById('collapseExample');
    var collapseInstance = new bootstrap.Collapse(collapseElement, { toggle: false });

    $('#communityBtn').on('click', function () {

        if (!state) {
            // SHOW
            collapseInstance.show();

            if (!isLoaded) {
                $('#communitiesList').html(`
                    <div class="text-center py-3">
                        <img src="https://assets-v2.lottiefiles.com/a/1618f642-117e-11ee-8f59-d76ebb44c951/llooygVZ6E.gif" alt="Loading..." style="width:96px;height:96px;">
                        <p class="text-muted mt-3 mb-0 fs-5">Loading communities...</p>
                    </div>
                `);

                $.ajax({
                    url: '/Home/loadCommunities/' + Cookies.get('email'),
                    method: 'GET',
                    accepts: 'application/json',
                    success: function (data) {
                        var communitiesHtml = '';
                        console.log(data);

                        if (data.length === 0) {
                            communitiesHtml = '<p class="text-muted">You are not part of any communities yet.</p>';
                        } else {
                            data.forEach(function (community) {
                                communitiesHtml += `
                                    <div class="card mb-3 border-0 shadow-sm rounded-3" style="background-color: #ffffff; transition: transform 0.2s ease-in-out; box-shadow: 0 5px 7px grey;">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center gap-3">
                                                ${community.cimage ? `
                                                    <img src="data:image/jpeg;base64,${toBase64Image(community.cimage)}"
                                                         class="rounded-3 border"
                                                         alt="${community.cname}"
                                                         style="width: 72px; height: 72px; object-fit: cover;">
                                                ` : `
                                                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-light border text-primary"
                                                         style="width: 72px; height: 72px; font-size: 1.6rem;">
                                                        🌍
                                                    </div>
                                                `}

                                                <div class="flex-grow-1 min-w-0">
                                                    <h6 class="mb-1 fw-semibold text-truncate">${community.cname}</h6>
                                                    <p class="mb-0 text-muted small">Travel community</p>
                                                </div>

                                                <a href="/Travel/CommunityDetails/${community.cid}"
                                                   class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                    Open
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                `;
                            });
                        }

                        $('#communitiesList').html(communitiesHtml);
                        isLoaded = true;
                    },
                    error: function (xhr, status, error) {
                        console.error('Error loading communities:', error);
                    }
                });
            }

            state = true;
        } else {
            // HIDE
            collapseInstance.hide();
            state = false;
        }
    });
});
    </script>

    
</body>

</html>
