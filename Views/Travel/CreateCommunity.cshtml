@model TravelBuddy.Models.Community

@{
    ViewData["Title"] = "Create Community";
    Layout = null;
}
@{
    if(ViewData["Message"] != null)
    {
        <div id="messagealert" class="alert alert-info alert-dismissible fade show" role="alert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" onclick="document.getElementById('messagealert').style.display='none'"></button>
            @ViewData["Message"]
        </div>
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Community - TravelBuddy</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            margin: 0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ================= HERO ================= */
        .hero {
            position: relative;
            height: 280px;
            background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') center/cover no-repeat;
        }

        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(0,0,0,0.55), rgba(15,32,39,0.95));
        }

        .hero-content {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
            animation: fadeDown 0.8s ease;
        }

        .hero-content h1 {
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .hero-content p {
            opacity: 0.85;
            margin-top: 10px;
            font-weight: 400;
        }

        /* ================= CARD ================= */
        .main-card {
            max-width: 1000px;
            margin: -90px auto 60px auto;
            border-radius: 20px;
            overflow: hidden;
            backdrop-filter: blur(20px);
            background: rgba(255,255,255,0.07);
            box-shadow: 0 25px 60px rgba(0,0,0,0.45);
            animation: fadeUp 0.8s ease;
        }

        .left-side {
            background: linear-gradient(135deg, #ff7e5f, #feb47b);
            padding: 60px 40px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .left-side h2 {
            font-weight: 700;
            font-size: 32px;
        }

        .left-side p {
            margin-top: 15px;
            font-size: 15px;
            opacity: 0.95;
        }

        .right-side {
            padding: 50px 45px;
            background: rgba(255,255,255,0.05);
            color: white;
        }

        /* ================= FORM ================= */
        .form-floating > .form-control {
            background: rgba(255,255,255,0.15);
            border: none;
            border-radius: 12px;
            color: white;
        }

        .form-floating > label {
            color: rgba(255,255,255,0.7);
        }

        .form-control:focus {
            background: rgba(255,255,255,0.25);
            box-shadow: 0 0 0 2px #feb47b;
            color: white;
        }

        /* Upload */
        .upload-box {
            border: 2px dashed rgba(255,255,255,0.4);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: 0.3s;
            background: rgba(255,255,255,0.05);
        }

        .upload-box:hover {
            background: rgba(255,255,255,0.15);
            border-color: #feb47b;
        }

        .upload-box img {
            width: 100%;
            max-height: 180px;
            object-fit: cover;
            border-radius: 12px;
            margin-top: 12px;
        }

        /* Button */
        .btn-create {
            background: linear-gradient(45deg, #ff7e5f, #feb47b);
            border: none;
            border-radius: 30px;
            padding: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .btn-create:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(255,126,95,0.4);
        }

        /* Password strength */
        .strength-bar {
            height: 6px;
            border-radius: 6px;
            margin-top: 8px;
            background: rgba(255,255,255,0.2);
            overflow: hidden;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            transition: 0.4s;
        }

        /* Animations */
        @@keyframes fadeDown {
            from { opacity: 0; transform: translateY(-25px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Responsive */
        @@media (max-width: 768px) {

            .hero {
                height: 220px;
            }

            .hero-content h1 {
                font-size: 26px;
            }

            .left-side {
                display: none;
            }

            .main-card {
                margin: -70px 15px 40px 15px;
            }

            .right-side {
                padding: 35px 25px;
            }
        }
    </style>
</head>

<body>

<!-- HERO -->
<div class="hero">
    <div class="hero-content">
        <div>
            <h1>TravelBuddy Community</h1>
            <p>Create private travel groups and explore together</p>
        </div>
    </div>
</div>

<!-- CARD -->
<div class="container">
    <div class="row main-card g-0">

        <!-- Left -->
        <div class="col-md-5 left-side">
            <h2>Build Your Travel Circle</h2>
            <p>
                Start a private community, share routes, track bikers live,
                and connect with voice & chat in real time.
            </p>
            <p class="mt-3 fw-semibold">Explore • Connect • Ride</p>
        </div>

        <!-- Right -->
        <div class="col-md-7 right-side">

            <h4 class="fw-bold mb-4">Create New Community</h4>

            <form asp-action="CreateCommunity" method="post" enctype="multipart/form-data">

                <div class="form-floating mb-3">
                    <input asp-for="cname" class="form-control" placeholder="Community Name" id="nameinput" required>
                    <label>Community Name</label>
                    <span asp-validation-for="cname" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-2">
                    <input asp-for="cpassword" type="password" class="form-control" placeholder="Password" id="passwordinput" required>
                    <label>Password</label>
                    <span asp-validation-for="cpassword" class="text-danger small"></span>

                    <div class="strength-bar">
                        <div class="strength-fill" id="strengthFill"></div>
                    </div>
                </div>


                <div class="form-floating mb-3">
                    <input asp-for="cemail" type="email" class="form-control" placeholder="Contact Email" id="emailinput" required>
                    <label>Contact Email</label>
                    <span asp-validation-for="cemail" class="text-danger small"></span>
                </div>


                <div class="mb-4" style="position: relative;">
                    <input type="file" name="ImageFile" id="imageUpload" hidden accept="image/*">
                    <div class="upload-box" onclick="document.getElementById('imageUpload').click()">
                        <div id="uploadText">Click to upload community image</div>
                        <img id="previewImage" style="display:none;">
                    </div>
                    <button type="button" id="removeImageBtn" style="display:none; position:absolute; top:10px; right:10px; z-index:10;" class="btn btn-sm btn-danger" onclick="removeImage()">×</button>
                </div>

                

                <button type="submit" class="btn btn-create w-100 text-white" onclick="return chkinputs();">
                                Create Community
                </button>
                <a asp-action="LoginCommunity" asp-controller="Travel" class="d-block text-center mt-3 text-decoration-none text-white">Already have a community? Log in</a>
            </form>
        
        </div>

    </div>
</div>

<script>

    function chkinputs(){
        if(document.getElementById("nameinput").value=="")
        {
            @* alert("Please fill in all required fields."); *@
            event.preventDefault();
            document.getElementById("nameinput").style.border="2px solid red";
        }
        else{
            document.getElementById("nameinput").style.border="none";
        }
        
        if(document.getElementById("passwordinput").value=="")
        {
            @* alert("Please fill in all required fields."); *@
            event.preventDefault();
            document.getElementById("passwordinput").style.border="2px solid red";
        }
        else{
            document.getElementById("passwordinput").style.border="none";
        }
        
        if(document.getElementById("emailinput").value=="")
        {
            @* alert("Please fill in all required fields."); *@
            event.preventDefault();
            document.getElementById("emailinput").style.border="2px solid red";
        }
        else{
            document.getElementById("emailinput").style.border="none";
        }


        if(document.getElementById("imageUpload").files.length==0)
        {
            @* alert("Please upload an image."); *@
            event.preventDefault();
            document.querySelector(".upload-box").style.border="2px dashed red";
            document.querySelector(".upload-box").style.borderColor = "red";
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-2';
            alertDiv.setAttribute('role', 'alert');
            alertDiv.innerHTML = 'Please upload an image. <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
            const closeBtn = alertDiv.querySelector('.btn-close');
            closeBtn.addEventListener('click', function () {
                alertDiv.remove();
            });
            document.querySelector(".upload-box").parentElement.appendChild(alertDiv);
        }
        else{
            document.querySelector(".upload-box").style.border="2px dashed rgba(255,255,255,0.4)";
        }
    }



    const upload = document.getElementById('imageUpload');
    const preview = document.getElementById('previewImage');
    const text = document.getElementById('uploadText');

    function removeImage() {
        upload.value = "";
        preview.src = "";
        preview.style.display = "none";
        text.style.display = "block";
        document.getElementById("removeImageBtn").style.display = "none";
    }

    upload.addEventListener('change', function () {
        const file = this.files[0];
        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
        
        if (file) {
            if (!allowedTypes.includes(file.type)) {
                alert('Please upload a valid image file (JPG, JPEG, or PNG)');
                upload.value = "";
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = "block";
                text.style.display = "none";
                document.getElementById("removeImageBtn").style.display = "block";
            }
            reader.readAsDataURL(file);
        }
    });

    const passwordInput = document.getElementById("passwordinput");
    const strengthFill = document.getElementById("strengthFill");

    passwordInput.addEventListener("input", function () {
        const val = passwordInput.value;
        let strength = 0;

        if (val.length > 5) strength += 25;
        if (/[A-Z]/.test(val)) strength += 25;
        if (/[0-9]/.test(val)) strength += 25;
        if (/[^A-Za-z0-9]/.test(val)) strength += 25;

        strengthFill.style.width = strength + "%";

        if (strength <= 25) strengthFill.style.background = "#ff4d4d";
        else if (strength <= 50) strengthFill.style.background = "#ff9800";
        else if (strength <= 75) strengthFill.style.background = "#ffc107";
        else strengthFill.style.background = "#4caf50";
    });
</script>

</body>
</html>