@page
@{
    // ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    
    <!-- Bootstrap 5.3.3 CDN (latest stable) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" 
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Font Awesome 6 for modern icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" 
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" 
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        :root {
            --primary-color: #6366f1;
        }

        body {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .login-container {
            max-width: 420px;
            width: 100%;
            margin: 20px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(16px);
            border: none;
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
            overflow: hidden;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .login-card:hover {
            transform: translateY(-4px);
        }

        .card-header {
            background: linear-gradient(90deg, #6366f1, #8b5cf6);
            color: white;
            padding: 2rem 1.5rem 1.5rem;
            text-align: center;
            border-bottom: none;
        }

        .logo-icon {
            font-size: 3.2rem;
            margin-bottom: 1rem;
            filter: drop-shadow(0 10px 15px rgba(0, 0, 0, 0.2));
        }

        .form-control {
            border-radius: 12px;
            padding: 14px 16px;
            border: 2px solid #e5e7eb;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
            outline: none;
        }

        .input-group-text {
            border-radius: 12px 0 0 12px;
            background: #f8fafc;
            border: 2px solid #e5e7eb;
            border-right: none;
        }

        .btn-login {
            height: 56px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 12px;
            background: linear-gradient(90deg, #6366f1, #8b5cf6);
            border: none;
            box-shadow: 0 10px 15px -3px rgb(99 102 241);
            transition: all 0.3s ease;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgb(99 102 241);
        }

        .form-label {
            font-weight: 500;
            color: #374151;
        }

        .password-toggle {
            cursor: pointer;
            color: #64748b;
        }

        .divider {
            position: relative;
            text-align: center;
            margin: 1.5rem 0;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #e5e7eb;
        }

        .divider span {
            background: white;
            padding: 0 20px;
            color: #64748b;
            font-size: 0.9rem;
        }

        @@media (max-width: 576px) {
            .login-card {
                border-radius: 16px;
                margin: 10px;
            }
            .card-header {
                padding: 1.75rem 1.25rem 1.25rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            
            <!-- Card Header -->
            <div class="card-header">
                <i class="fa-solid fa-shield-halved logo-icon"></i>
                <h1 class="h3 fw-bold mb-1">Welcome Back</h1>
                <p class="mb-0 opacity-75">Sign in to access your account</p>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4 p-md-5">
                
                <!-- Optional error message area (Razor binding) -->
                

                <form method="post" asp-action="Login" asp-controller="Account">
                    @if(TempData["Message"]!=null){
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Message"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <!-- Username Field -->
                    <div class="mb-4">
                        <label for="Username" class="form-label">Username</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fa-solid fa-user"></i>
                            </span>
                            <input type="text" 
                                   class="form-control" 
                                   id="Username" 
                                   name="email" 
                                   placeholder="Enter your email" 
                                   required 
                                   autofocus />
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-4">
                        <label for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input type="password" 
                                   class="form-control" 
                                   id="Password" 
                                   name="password" 
                                   placeholder="Enter your password" 
                                   required />
                            <button class="input-group-text password-toggle border-0 bg-transparent" 
                                    type="button" 
                                    onclick="togglePasswordVisibility()">
                                <i class="fa-solid fa-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember me + Forgot Password -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="RememberMe" name="RememberMe" value="true">
                            <label class="form-check-label" for="RememberMe">
                                Remember me
                            </label>
                        </div>
                        <a href="#" class="text-decoration-none text-primary fw-medium">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Login Button -->
                    <button type="submit" class="btn btn-primary btn-login w-100 d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>
                        SIGN IN
                    </button>
                </form>

                <!-- Divider -->
                
                <!-- Sign up link -->
                <div class="text-center mt-4">
                    <p class="text-muted mb-0">
                        Don't have an account? 
                        <a href="/Account/CreateUsr" class="text-primary fw-semibold text-decoration-none">Create one now</a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Footer note -->
        <div class="text-center mt-4 text-white-50 small">
            <i class="fa-solid fa-lock me-1"></i>
            Secured by enterprise-grade encryption
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" 
            crossorigin="anonymous"></script>

    <script>
        /**
         * Toggle password visibility (modern UX feature)
         */
        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('Password');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // Auto-focus username on page load (mobile friendly)
        window.addEventListener('load', () => {
            const usernameField = document.getElementById('Username');
            if (usernameField) usernameField.focus();
        });

        // Optional: Close any alerts automatically after 5 seconds
        setTimeout(() => {
            const alert = document.querySelector('.alert');
            if (alert) alert.style.transition = 'opacity 0.5s';
            if (alert) alert.style.opacity = '0';
        }, 5000);
    </script>
</body>
</html>